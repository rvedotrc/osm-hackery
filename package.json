    "test:lint": "eslint src test",
    "test:package-json": "npmPkgJsonLint .",
    "test:unit": "node --enable-source-maps --test './test/**/*.test.ts'"
  },
  "dependencies": {
    "@blaahaj/geometry": "^1.1.0",
    "@blaahaj/gotcha": "^2.0.0",
    "axios": "^1.20.0",
    "effect": "^3.22.2",
    "fast-xml-parser": "^5.11.1",
    "geojson": "^0.5.0",
    "sax": "^1.6.1",
    "type-fest": "^5.10.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@blaahaj/std": "^1.0.3",
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/sax": "^1.2.7",
    "@types/write-file-atomic": "^4.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "npm-package-json-lint": "^11.0.0",
    "npm-package-json-lint-config-default": "^10.0.0",
    "prettier": "^3.9.9",
    "prettier-cli": "^0.1.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
